# Copy to .env and load in the shell that runs FastAPI and the invite command.
# Use the exact public origin where recipients will open their links.
YLD_PUBLIC_URL=http://127.0.0.1:5173
YLD_DB_PATH=api/yld.db
# Set YLD_ENV=production on the deployed server after adding an HTTPS public URL.

# Required to email invitations and sign-in links.
RESEND_API_KEY=
YLD_EMAIL_FROM='YLD <invites@your-verified-domain.nz>'
