# Copy to .env and load in the shell that runs FastAPI and the admin bootstrap command.
# Use the exact public origin where recipients will open their links.
YLD_PUBLIC_URL=http://127.0.0.1:5173
YLD_DB_PATH=api/yld.db
# Enable only after a separate model worker and its restricted Docker network are running.
YLD_MODEL_WORKER_ENABLED=0
# Optional: use a dedicated key for agent-suggested spreadsheet mappings.
# Without it, the same mapping review uses local header rules.
YLD_IMPORT_AGENT_API_KEY=
YLD_IMPORT_AGENT_MODEL=gpt-4o-mini
# Set YLD_ENV=production on the deployed server after adding an HTTPS public URL.

# Required to email invitations from the admin page.
RESEND_API_KEY=
YLD_EMAIL_FROM='YLD <invites@your-verified-domain.nz>'

# Stripe sandbox only. Create two monthly recurring NZD Prices in Stripe test mode.
# Checkout stays unavailable unless every value below is set and the secret starts with sk_test_.
YLD_STRIPE_TEST_CHECKOUT=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LOCAL=
STRIPE_PRICE_MULTI_CHAIN=
