
# YLD shares only the existing edge network. Its container publishes no host port.
yld.nz {
	@api path /api/*
	handle @api {
		reverse_proxy yld-api:8000
	}

	handle {
		reverse_proxy https://yld-one.vercel.app {
			header_up Host yld-one.vercel.app
		}
	}
}

www.yld.nz {
	redir https://yld.nz{uri} permanent
}
