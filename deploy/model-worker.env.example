# Use a separate mode-0600 file for the host-side worker. Never mount it in a container.
# Production uses the same restricted yld_app Postgres connection as the API.
DATABASE_URL=
# For local SQLite instead: YLD_DB_PATH=/absolute/path/to/yld/data/yld.db
CODEX_API_KEY=
YLD_AGENT_NETWORK=
YLD_AGENT_PROXY=http://yld-model-proxy:3128
YLD_AGENT_IMAGE=yld-model-agent:1
YLD_TRAINER_IMAGE=yld-model-trainer:1
