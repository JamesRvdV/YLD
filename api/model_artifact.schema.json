{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "integer", "enum": [1]},
    "algorithm": {"type": "string", "enum": ["ridge_weekday_v1", "ridge_decay_v1"]},
    "window": {"type": "integer", "enum": [28, 56, 112]},
    "penalty": {"type": "number", "enum": [0.5, 2, 10, 50]},
    "models": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "dish_id": {"type": "string", "minLength": 1, "maxLength": 64},
          "coefficients": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "number", "minimum": -10000, "maximum": 10000}},
          "sigma": {"type": "number", "minimum": 1.8, "maximum": 10000},
          "min_covers": {"type": "integer", "minimum": 1, "maximum": 100000},
          "max_covers": {"type": "integer", "minimum": 1, "maximum": 100000},
          "max_sold": {"type": "integer", "minimum": 0, "maximum": 1000000}
        },
        "required": ["dish_id", "coefficients", "sigma", "min_covers", "max_covers", "max_sold"]
      }
    }
  },
  "required": ["schema_version", "algorithm", "window", "penalty", "models"]
}
